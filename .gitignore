# Python build artifacts
build/
dist/
*.egg-info/
*.egg

# Virtual environment
.venv/
venv/

# Byte-compiled Python files (generated automatically when Python runs)
__pycache__/
*.py[cod]

# pytest cache
.pytest_cache/

# Coverage reports (generated by pytest-cov / make coverage)
htmlcov/
.coverage

# Ruff cache
.ruff_cache/

# IDE settings (VS Code, PyCharm, etc.)
.vscode/
.idea/

# OS files
.DS_Store

# license-comply disk cache (generated at runtime)
.license-comply-cache.json

# Generated report files (created by the tool, not source code)
license-comply-report.*

# Local development config
CLAUDE.md

# Environment files — API keys for the optional AI summary must never be committed
.env
.env.*

# Internal design specification (not for public distribution)
license-comply-spec.md

# Internal design/planning documents
docs/plans/
